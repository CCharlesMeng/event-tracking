{
  "name": "event-tracking-sdk",
  "version": "1.0.0",
  "private": true,
  "description": "Framework-agnostic auto-tracking SDK for B-side frontend systems",
  "type": "module",
  "main": "./dist/event-tracking.esm.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:unit": "vitest run --exclude test/e2e.test.ts",
    "test:e2e": "vitest run test/e2e.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run smoke"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
